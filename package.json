{
  "name": "wav-clip-inspection-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "纯浏览器 WAV 削波核验台：按声道扫描归一化 PCM 削波段，不上传任何文件。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
